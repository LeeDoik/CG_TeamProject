<?xml version="1.0" encoding="utf-8"?>
<!-- 수업 실습(02_OpenGL_xx)과 같은 방식: GLEW/GLFW/GLM을 프로젝트 안 dependencies 폴더에서 가져온다.
     GL 헤더를 전역으로 설치한 PC에서도 이 폴더가 먼저 쓰인다. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OpenGLDependencies>$(MSBuildThisFileDirectory)dependencies\</OpenGLDependencies>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Platform)'=='x64'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(OpenGLDependencies)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(OpenGLDependencies)lib\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>opengl32.lib;glew32.lib;glfw3.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="CheckOpenGLPlatform" BeforeTargets="PrepareForBuild" Condition="'$(Platform)'!='x64'">
    <Error Text="수업용 OpenGL 라이브러리는 64비트입니다. 플랫폼을 x64로 선택하세요." />
  </Target>
  <Target Name="CopyOpenGLRuntime" AfterTargets="Build" Condition="'$(Platform)'=='x64'">
    <Copy SourceFiles="$(OpenGLDependencies)bin\x64\glew32.dll;$(OpenGLDependencies)bin\x64\glfw3.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
